# Claude API 키 (https://console.anthropic.com 에서 발급) — AI 자동 태깅/코디 추천/쇼핑 도우미에 필요
ANTHROPIC_API_KEY=
# 웹에 공개할 때 반드시 설정하세요. 로그인 비밀번호입니다.
APP_PASSWORD=
# 세션 쿠키 서명용 임의 문자열 (선택, 길고 무작위로)
SESSION_SECRET=
# 사진과 DB를 저장할 폴더 (기본 ./data)
DATA_DIR=./data
PORT=3000
# 사용할 Claude 모델 (기본 claude-opus-5)
# CLOSET_MODEL=claude-opus-5
